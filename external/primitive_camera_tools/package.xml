<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>primitive_camera_tools</name>
  <version>0.1.0</version>
  <description>Camera frame publishing (sensor-kit style calibration + live IMU orientation)
    and an audible alert for the primitive emergency detector.</description>
  <maintainer email="nuri.ulusoy@robeff.com">nuri</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
